# Copy this file to config/guli-identity.public.env when preparing a release.
# These are public OIDC PKCE client settings. Never add client_secret, password,
# token, API key, or any other private credential to this file.
GULI_IDENTITY_ISSUER=https://auth.guliacer.dpdns.org
GULI_IDENTITY_CLIENT_ID=guli_suyan_desktop_public_v1
GULI_IDENTITY_REDIRECT_URI=suyan://oauth/callback
# profile 用于读取绑定方式、昵称和头像；offline_access 是签发 refresh_token 的前提。
GULI_IDENTITY_SCOPES=openid email profile offline_access
