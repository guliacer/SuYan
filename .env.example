# SuYan local env example
# Put real API keys only in the app AI settings UI.
# Keys are encrypted into userData/library/ai-settings.json and must never be committed.

# Optional package output directory override
# PROMPT_PACKAGE_OUTPUT_DIR=release

# Guli Identity OIDC（桌面端公共 PKCE 客户端，不需要 client_secret）
# 本地 package:win 优先读取 private/guli-identity.env；正式包也只会提取以下公开字段。
# 若将 config/guli-identity.public.env 纳入项目，正式包会优先使用它。
GULI_IDENTITY_ISSUER=https://auth.guliacer.dpdns.org
GULI_IDENTITY_CLIENT_ID=
GULI_IDENTITY_REDIRECT_URI=suyan://oauth/callback
# offline_access 是签发 refresh_token 的前提；去掉它登录只能活到 access token 过期（15 分钟）。
# refresh token 轮转（旧值刷新后立即失效），仅在主进程 safeStorage 中加密存储。
GULI_IDENTITY_SCOPES=openid email profile offline_access
