{
  "name": "suyan",
  "version": "0.3.6",
  "private": false,
  "author": {
    "name": "guliacer",
    "url": "https://github.com/guliacer"
  },
  "description": "本地 AI 提示词与图像素材管理工具",
  "main": "dist-electron/electron/main/index.js",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "build": "pnpm build:renderer && pnpm build:electron",
    "build:renderer": "node scripts/clean-dist.cjs && vite build",
    "build:electron": "node scripts/clean-dist.cjs dist-electron && tsc -p tsconfig.electron.json",
    "build:rust-core": "node scripts/build-rust-core.cjs",
    "typecheck": "pnpm typecheck:renderer && pnpm typecheck:electron",
    "typecheck:renderer": "tsc -p tsconfig.json --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "package:win": "node scripts/clean-dist.cjs && node node_modules/vite/bin/vite.js build && node scripts/clean-dist.cjs dist-electron && node node_modules/typescript/bin/tsc -p tsconfig.electron.json && node scripts/build-rust-core.cjs && node package-win.cjs",
    "package:win:release": "node scripts/package-win-release.cjs",
    "package:win:editions": "node scripts/package-win-editions.cjs",
    "components:sign-nsfw": "node scripts/components/sign-nsfw-release.cjs sign",
    "protect:electron": "node scripts/obfuscate-electron.cjs dist-electron",
    "check:secrets": "node scripts/check-no-secrets.cjs",
    "check:empty-shell": "node scripts/check-empty-shell.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "chokidar": "4.0.3",
    "jszip": "3.10.1",
    "lucide-react": "1.23.0",
    "openid-client": "5.7.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.4",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "ffmpeg-static": "5.2.0",
    "javascript-obfuscator": "5.4.7",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.9"
  },
  "build": {
    "appId": "local.suyan",
    "productName": "素言",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "app-integrity.json",
      "!**/*.map",
      "!**/*.md",
      "!**/LICENSE*",
      "!**/license*",
      "!**/*.env",
      "!**/.env*",
      "!**/ai-settings.json",
      "!**/proxy-settings.json",
      "!**/view-settings.json",
      "!**/window-state.json",
      "!**/file-dialog-settings.json",
      "!**/library.json",
      "!**/secrets/**",
      "!**/private/**",
      "!**/*.pem",
      "!**/*.key",
      "!**/*.p12",
      "!**/*.pfx"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "legalTrademarks": "素言 SuYan"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "素言",
      "uninstallDisplayName": "素言",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "copyright": "Copyright © 2026 素言 SuYan. All rights reserved.",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/guliacer/SuYan",
  "bugs": {
    "url": "https://github.com/guliacer/SuYan/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guliacer/SuYan.git"
  },
  "keywords": [
    "electron",
    "react",
    "prompt",
    "ai",
    "image-library",
    "suyan"
  ]
}
